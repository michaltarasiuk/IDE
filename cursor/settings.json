{
  // Window & app
  "security.workspace.trust.untrustedFiles": "open",
  "update.mode": "start",
  "window.autoDetectColorScheme": false,
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "window.titleBarStyle": "custom",

  // Workbench
  "breadcrumbs.enabled": false,
  "outline.collapseItems": "alwaysCollapse",
  "workbench.activityBar.location": "top",
  "workbench.agentsWindowButton.enabled": false,
  "workbench.colorTheme": "Black Mono (No Italics)",
  "workbench.editor.customLabels.enabled": true,
  "workbench.editor.customLabels.patterns": {
    "**/error.tsx": "${dirname(1)}/${filename}",
    "**/layout.tsx": "${dirname(1)}/${filename}",
    "**/loading.tsx": "${dirname(1)}/${filename}",
    "**/page.tsx": "${dirname(1)}/${filename}",
    "**/route.ts": "${dirname(1)}/${filename}",
  },
  "workbench.editor.decorations.badges": false,
  "workbench.editor.decorations.colors": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.highlightModifiedTabs": false,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.showIcons": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabSizing": "shrink",
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "pierre-icons-minimal",
  "workbench.layoutControl.enabled": false,
  "workbench.list.horizontalScrolling": false,
  "workbench.list.smoothScrolling": true,
  "workbench.navigationControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "none",

  // Explorer
  "explorer.compactFolders": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,
  "explorer.sortOrder": "type",

  // Cursor
  "cursor.composer.conversationDensity": "compact-all-grouped",
  "cursor.composer.showEmptyStateTips": false,
  "cursor.general.fontSmoothingAntialiased_v2": true,

  // Editor: typography & chrome
  "editor.codeLensFontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 2,
  "editor.detectIndentation": false,
  "editor.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.glyphMargin": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlayHints.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "editor.inlineSuggest.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "editor.insertSpaces": true,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 1.5,
  "editor.linkedEditing": true,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.overviewRulerBorder": false,
  "editor.padding.bottom": 8,
  "editor.padding.top": 8,
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "none",
  "editor.rulers": [],
  "editor.scrollBeyondLastLine": false,
  "editor.scrollbar.horizontal": "auto",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 8,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",

  // Editor: guides & brackets
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": false,
  "editor.guides.bracketPairsHorizontal": false,
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": false,

  // Editor: suggest & lightbulb
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.inlineSuggest.enabled": true,
  "editor.lightbulb.enabled": "off",
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",

  // Editor: format on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,

  // Files & search
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.svelte-kit/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
  },
  "search.exclude": {
    "**/*.lockb": true,
    "**/.svelte-kit": true,
    "**/.turbo": true,
    "**/bun.lock": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/target": true,
  },

  // Terminal
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "terminal.integrated.fontLigatures.enabled": false,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.letterSpacing": 0,
  "terminal.integrated.lineHeight": 1.5,
  "terminal.integrated.scrollback": 10000,

  // Fonts: debug / SCM / notebook
  "debug.console.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "debug.console.fontSize": 12,
  "debug.console.lineHeight": 18,
  "notebook.markup.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "notebook.output.fontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "scm.inputFontFamily": "'Iosevka', 'Iosevka Extended', Menlo, Monaco, monospace",
  "scm.inputFontSize": 12,

  // Git / SCM / diff
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": false,
  "git.blame.statusBarItem.enabled": false,
  "git.confirmSync": false,
  "git.decorations.enabled": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "problems.decorations.enabled": false,
  "scm.diffDecorations": "none",

  // TypeScript / JavaScript
  "js/ts.inlayHints.parameterNames.enabled": "none",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // Language tools
  "biome.suggestInstallingGlobally": false,
  "css.lint.unknownAtRules": "ignore",
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "svelte"],
  "eslint.workingDirectories": [
    {
      "mode": "auto",
    },
  ],
  "go.formatTool": "default",
  "go.useLanguageServer": true,
  "json.schemaDownload.enable": true,
  "prettier.requireConfig": true,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "scss.lint.unknownAtRules": "ignore",
  "svelte.enable-ts-plugin": true,
  "tailwindCSS.experimental.classRegex": [
    ["tv\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["clsx\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["class:\\s*[\"'`]([^\"'`]*)\""],
  ],
  "tailwindCSS.includeLanguages": {
    "svelte": "html",
  },

  // Language overrides
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.tabSize": 4,
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
}
